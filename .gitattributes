# Line endings: always LF in the repository, whatever the machine.
* text=auto eol=lf
*.xlsx binary
*.png binary
*.jpg binary

# SheetJS is vendored third-party minified code. Without this, GitHub reports
# the project as "96 % JavaScript" and means one foreign file.
js/vendor/* linguist-vendored

# The example workbook is generated by tools/make-example.mjs, not written.
examples/*.xlsx linguist-generated

sprites/* linguist-vendored
docs/* linguist-documentation
